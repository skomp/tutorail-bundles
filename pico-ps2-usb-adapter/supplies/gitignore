# --- build output -----------------------------------------------------------
# Everything CMake generates. Nothing in here is worth committing and some of it is
# tens of megabytes.
build/
build-*/
cmake-build-*/
out/

# Firmware images and link artefacts, in case one ends up outside the build tree.
*.uf2
*.elf
*.bin
*.hex
*.dis
*.map
*.o
*.a
*.d

# --- machine-specific configuration ------------------------------------------
# device.env holds the serial port path of your debug console, which is different on
# every machine and changes when you replug. It is yours, not the repository's.
# device.env.template is committed; the filled-in copy is not.
device.env
device.env.local

