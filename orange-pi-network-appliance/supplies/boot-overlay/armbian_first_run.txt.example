# Rename to armbian_first_run.txt on the boot partition and edit.
# Armbian consumes this file on first boot, then removes it.

FR_general_delete_this_file_after_completion=1

# Hostname the board will answer to (lesson 00 looks for it by mDNS as
# <hostname>.local as one of several ways to find the board).
FR_general_hostname=orangepizero3

# Wi-Fi regulatory country (ISO 3166-1 alpha-2, e.g. DE, GB, US). Set the one you
# are actually in. This is the reg-domain hostapd needs in lesson 03.
FR_general_wifi_country_code=DE

# Leave SSH on so lesson 00 can reach the board.
FR_net_ssh_enabled=1
